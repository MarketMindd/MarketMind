{
  "name": "@market-mind/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start:frontend": "nx serve frontend --no-tui",
    "build:frontend": "nx build frontend --no-tui",
    "start:api": "nx serve backend-api --no-tui --skip-nx-cache",
    "build:api": "nx build backend-api --no-tui",
    "build:production": "tsc -b libs/common/tsconfig.lib.json libs/database/tsconfig.lib.json && nx build backend-api && nx build frontend && mkdir -p apps/backend-api/dist/public && cp -r apps/frontend/dist/* apps/backend-api/dist/public/ && cp -r apps/backend-api/dist .",
    "simulate:recommendation": "node -r tsconfig-paths/register -r @swc-node/register ./apps/backend-api/src/recommendation-simulator/main.ts",
    "db:migrate": "npm run db:migrate -w @market-mind/database",
    "db:migration:revert": "npm run db:migration:revert -w @market-mind/database",
    "db:migration:show": "npm run db:migration:show -w @market-mind/database",
    "db:migration:generate": "npm run db:migration:generate -w @market-mind/database",
    "db:migration:create": "npm run db:migration:create -w @market-mind/database --"
  },
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@nx/eslint": "22.5.2",
    "@nx/eslint-plugin": "22.5.2",
    "@nx/js": "22.5.2",
    "@nx/nest": "^22.5.2",
    "@nx/node": "22.5.2",
    "@nx/react": "^22.5.2",
    "@nx/vite": "22.5.2",
    "@nx/web": "22.5.2",
    "@nx/webpack": "22.5.2",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/jest": "^30.0.0",
    "@types/node": "20.19.9",
    "@types/nodemailer": "^7.0.1",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jiti": "2.4.2",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "22.5.2",
    "prettier": "~3.6.2",
    "tslib": "^2.3.0",
    "tsx": "^4.22.4",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0"
  },
  "workspaces": [
    "libs/*",
    "apps/*"
  ],
  "dependencies": {
    "nodemailer": "^7.0.3",
    "react-ts-tradingview-widgets": "^1.2.8"
  }
}