{
  "name": "@market-mind/database",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "db:migrate": "node -r tsconfig-paths/register -r @swc-node/register ../../node_modules/typeorm/cli.js migration:run -d ./src/datasource/datasource.ts",
    "db:migration:revert": "node -r tsconfig-paths/register -r @swc-node/register ../../node_modules/typeorm/cli.js migration:revert -d ./src/datasource/datasource.ts",
    "db:migration:generate": "node -r tsconfig-paths/register -r @swc-node/register ../../node_modules/typeorm/cli.js migration:generate -d ./src/datasource/datasource.ts ./src/migrations/generated-migration",
    "db:migration:create": "node -r tsconfig-paths/register -r @swc-node/register ../../node_modules/typeorm/cli.js migration:create ./src/migrations/empty-migration ",
    "db:migration:show": "node -r tsconfig-paths/register -r @swc-node/register ../../node_modules/typeorm/cli.js migration:show -d ./src/datasource/datasource.ts"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@market-mind/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "pg": "^8.11.3",
    "tslib": "^2.3.0",
    "typeorm": "^0.3.22",
    "dotenv": "16.4.7",
    "reflect-metadata": "0.1.14",
    "@market-mind/common": "0.0.1"
  },
  "devDependencies": {
    "ts-node": "^10.9.2"
  }
}
