{
  "name": "@market-mind/database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "db:migrate": "node ./scripts/run-typeorm.mjs migration:run",
    "db:migration:revert": "node ./scripts/run-typeorm.mjs migration:revert",
    "db:migration:show": "node ./scripts/run-typeorm.mjs migration:show",
    "db:migration:generate": "node ./scripts/run-typeorm.mjs migration:generate"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@market-mind/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.1.14",
    "tslib": "^2.3.0",
    "typeorm": "^0.3.22"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typeorm-ts-node-esm": "^0.3.20"
  }
}
