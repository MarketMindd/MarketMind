{
  "name": "@market-mind/database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "db:migrate": "npx typeorm-ts-node-esm migration:run -d ./src/datasource/datasource.ts",
    "db:migration:revert": "npx typeorm-ts-node-esm migration:revert -d ./src/datasource/datasource.ts",
    "db:migration:generate": "npx typeorm-ts-node-esm migration:generate -d ./src/datasource/datasource.ts ./src/migrations/generated-migration",
    "db:migration:create": "npx typeorm-ts-node-esm migration:create ./src/migrations/empty-migration ",
    "db:migration:show": "npx typeorm-ts-node-esm migration:show -d ./src/datasource/datasource.ts"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@market-mind/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "pg": "^8.11.3",
    "tslib": "^2.3.0",
    "typeorm": "^0.3.22"
  },
  "devDependencies": {
    "ts-node": "^10.9.2"
  }
}
